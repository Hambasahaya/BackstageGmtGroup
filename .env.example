# Google OAuth refresh token must include these scopes:
# - https://www.googleapis.com/auth/adwords
# - https://www.googleapis.com/auth/webmasters.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional short-lived token for local testing. Prefer refresh token in production.
GOOGLE_OAUTH_ACCESS_TOKEN=

# Frontend API and uploaded asset hosts.
VITE_API_BASE_URL=http://localhost:8080
# Dedicated Social Media AI Agent API. Other features keep using VITE_API_BASE_URL.
VITE_SOSMED_AGENT_BASE_URL=http://localhost:8000
VITE_ASSET_BASE_URL=https://is3.cloudhost.id/gmtsuites
VITE_CLIENT_NAME=website_utama

# Google Analytics Data API (GA4)
# Service account (recommended). Grant its client_email Viewer access in GA4.
GOOGLE_APPLICATION_CREDENTIALS=
# Deployment alternatives when a local file is unavailable:
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_BASE64=

# OAuth is also supported. Its refresh token must include analytics.readonly.
# Configure multiple websites as a JSON array of GA4 numeric property IDs.
# Add gscSiteUrl per website to enable keyword performance from Search Console.
# Leave both property variables empty to auto-discover all properties accessible
# by the service account or OAuth user.
GA4_PROPERTIES=[{"id":"123456789","name":"GMT Lighting","domain":"gmtlighting.id","gscSiteUrl":"https://gmtlighting.id/"},{"id":"987654321","name":"GMT Training","domain":"gmttraining.id"}]
GA4_REPORT_DAYS=30

# Alternative compact format when JSON env values are inconvenient:
# GA4_PROPERTY_IDS=123456789:gmtlighting.id,987654321:gmttraining.id
GA4_PROPERTY_IDS=

# Google Ads API / Keyword Planner
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_LANGUAGE_RESOURCE=languageConstants/1044
GOOGLE_ADS_LOCATION_RESOURCE=geoTargetConstants/2360

# Google Search Console property URL.
# Use the exact verified property, for example:
# GSC_SITE_URL=https://gmtgroup.co.id/
# GSC_SITE_URL=sc-domain:gmtgroup.co.id
GSC_SITE_URL=https://gmtgroup.co.id/

# Meta / Instagram API
# Create a Meta Business app and add this redirect URI in Meta Developer Dashboard.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/meta/callback
META_DASHBOARD_URL=http://localhost:5173/integrations
META_GRAPH_VERSION=v22.0
# Gunakan "instagram" untuk token dari Instagram Login (biasanya berawalan IGA).
META_API_MODE=

# Requested scopes depend on features. Keep only what your app really uses before App Review.
META_SCOPES=pages_show_list,pages_read_engagement,instagram_basic,instagram_manage_insights,instagram_manage_comments

# Optional: set this to validate OAuth state. Use a random string in production.
META_OAUTH_STATE=

# Recommended env-only mode for multiple Instagram accounts.
# Use a long-lived Meta user token. The backend discovers managed Pages,
# Page access tokens, and linked Instagram Business accounts automatically.
META_ACCESS_TOKEN=

# Dashboard query configuration.
META_INSIGHT_DAYS=30
META_MEDIA_LIMIT=25
META_ACCOUNT_INSIGHT_METRICS=reach,profile_views,website_clicks,follower_count

# Server-side token storage for local/prototype use.
# In production, replace this file store with a database/KV/secret store.
META_TOKEN_STORE_PATH=

# Optional bootstrap tokens for local testing without OAuth callback storage.
META_USER_ACCESS_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_IG_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
META_IG_USERNAME=

# Optional multiple direct Instagram accounts.
# Keep as one line JSON. Each item needs an accessToken and igUserId.
# This preserves the single account variables above while enabling the dashboard dropdown.
META_INSTAGRAM_ACCOUNTS=[{"igUserId":"17841400000000001","username":"brand.one","accessToken":"IGA_or_page_token_1"},{"igUserId":"17841400000000002","username":"brand.two","accessToken":"IGA_or_page_token_2"}]

# Optional custom references for "Referensi Terbaik" per Instagram account.
# References are only inspiration for hook, style, structure, and CTA.
# Alibaba must adapt them to the selected account, not copy them or treat them as account performance data.
# You can provide post links, Reel links, account links, and optional notes/captions.
META_CONTENT_REFERENCES=[{"igUserId":"17841400000000001","username":"brand.one","references":[{"url":"https://www.instagram.com/p/POST_ID/","contentType":"Carousel","note":"Contoh struktur edukasi teknis yang ingin ditiru."},{"url":"https://www.instagram.com/reel/REEL_ID/","contentType":"Reels","note":"Contoh hook cepat dan visual opening."},{"accountUrl":"https://www.instagram.com/competitor.account/","contentType":"Account","note":"Akun pembanding untuk gaya visual dan cadence."}]},{"igUserId":"17841400000000002","username":"brand.two","references":["https://www.instagram.com/p/POST_ID_2/"]}]

# Alibaba Cloud Model Studio reasoning for Instagram Content / Post Level.
# Uses the OpenAI-compatible endpoint.
ALIBABA_MODEL_STUDIO_API_KEY=
ALIBABA_MODEL_STUDIO_BASE_URL=https://ws-wqykgjdhllxiyyu0.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
ALIBABA_MODEL=qwen3.7-plus
ALIBABA_MULTIMODAL_MODEL=qwen3.5-omni-plus-2026-03-15

# Website Pusat backend API.
# Use http://localhost:8080 for local backend, or leave empty when Vite proxies /api to the same origin.
API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080

# Website Pusat SSO client.
CLIENT_NAME=website_utama
VITE_CLIENT_NAME=website_utama
SSO_CALLBACK_URL=http://localhost:5173/sso/callback
VITE_SSO_CALLBACK_URL=http://localhost:5173/sso/callback

# Optional logout target. If user entered from Website A/SSO, logout can return there.
WEBSITE_A_URL=https://website-a.com
VITE_WEBSITE_A_URL=https://website-a.com
VITE_WEBSITE_PUSAT_URL=http://localhost:5173
VITE_MYGMT_ENTRY_URL=http://localhost:5173/mygmt
VITE_LOGOUT_REDIRECT_URL=/

# Article migration from old website.
# Start with dry-run=true to inspect scraped data before saving to the API.
OLD_ARTICLE_SITE_URL=https://website-lama.com
# Optional: isi satu atau banyak link artikel langsung, pisahkan dengan koma atau baris baru.
# Jika ARTICLE_IMPORT_URLS diisi, script tidak akan scan WordPress/sitemap.
ARTICLE_IMPORT_URLS=
ARTICLE_IMPORT_ENDPOINT=/api/articles
ARTICLE_IMPORT_TOKEN=
ARTICLE_IMPORT_EMAIL=
ARTICLE_IMPORT_PASSWORD=
ARTICLE_IMPORT_CLIENT=website_utama
ARTICLE_IMPORT_LIMIT=
ARTICLE_IMPORT_CONCURRENCY=3
ARTICLE_IMPORT_DRY_RUN=true
