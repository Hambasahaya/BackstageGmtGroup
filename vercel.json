{
    "rewrites":  [
                     {
                         "source":  "/api/meta/:path*",
                         "destination":  "/api/meta/index.js"
                     },
                     {
                         "source":  "/api/super-admin/onboarding/videos/:id",
                         "destination":  "/api/super-admin/onboarding/videos.js?id=:id"
                     },
                     {
                         "source":  "/api/super-admin/onboarding/videos",
                         "destination":  "/api/super-admin/onboarding/videos.js"
                     },
                     {
                         "source":  "/api/agent/onboarding/videos",
                         "destination":  "/api/agent/onboarding/videos.js"
                     },
                     {
                         "source":  "/api/agent/onboarding/progress",
                         "destination":  "/api/agent/onboarding/progress.js"
                     },
                     {
                         "source":  "/api/(.*)",
                         "destination":  "/api/$1"
                     },
                     {
                         "source":  "/(.*)",
                         "destination":  "/index.html"
                     }
                 ],
    "redirects":  [
                      {
                          "destination":  "https://gmtgroup.co.id/gmt-suite-auth?mode=login",
                          "permanent":  false,
                          "source":  "/login"
                      },
                      {
                          "destination":  "https://gmtgroup.co.id/gmt-suite-auth?mode=login",
                          "permanent":  false,
                          "source":  "/register"
                      },
                      {
                          "destination":  "https://gmtgroup.co.id/gmt-suite-auth?mode=login",
                          "permanent":  false,
                          "source":  "/forgot-password"
                      },
                      {
                          "destination":  "https://gmtgroup.co.id/gmt-suite-auth?mode=login",
                          "permanent":  false,
                          "source":  "/reset-password"
                      }
                  ]
}
